# Umami analytics (optional — script is omitted entirely if either is unset)
UMAMI_SCRIPT_URL=https://your-umami-instance.example.com/script.js
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# raptrx-ui registry (only needed to add or update components with the shadcn CLI, not to build)
RAPTRX_UI_URL=http://localhost:3000
RAPTRX_UI_TOKEN=
