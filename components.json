{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks",
    "utils": "@/raptrx-ui/system/utils/cn"
  },
  "registries": {
    "@raptrx": {
      "url": "${RAPTRX_UI_URL}/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${RAPTRX_UI_TOKEN}"
      }
    }
  }
}
